generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  intakes   Intake[]
  tasks     Task[]
  documents Document[]
  events    Event[]
  processes Process[]

  @@map("users")
}

model Client {
  id            String    @id @default(cuid())
  fullName      String    @map("full_name")
  cpf           String    @unique
  rg            String?
  birthDate     DateTime? @map("birth_date") @db.Date
  maritalStatus String?   @map("marital_status")
  profession    String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  intakes   Intake[]
  companies Company[]
  documents Document[]
  processes Process[]

  @@index([fullName])
  @@map("clients")
}

model Company {
  id                    String   @id @default(cuid())
  cnpj                  String   @unique
  razaoSocial           String   @map("razao_social")
  nomeFantasia          String?  @map("nome_fantasia")
  phone                 String?
  email                 String?
  address               String?
  isActive              Boolean  @default(true) @map("is_active")
  legalRepresentativeId String   @map("legal_representative_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  legalRepresentative Client     @relation(fields: [legalRepresentativeId], references: [id], onDelete: Restrict)
  intakes             Intake[]
  documents           Document[]

  @@index([legalRepresentativeId])
  @@map("companies")
}

enum PracticeArea {
  PREVIDENCIARIO
  TRABALHISTA
  CIVEL
  FAMILIA
  CONSUMIDOR
  EMPRESARIAL
  CONTRATOS
  OUTRO
}

enum NextStep {
  SOLICITAR_DOCUMENTOS
  ELABORAR_PARECER
  AGENDAR_RETORNO
  ELABORAR_CONTRATO
  PROTOCOLAR_ACAO
  TENTATIVA_ACORDO
  OUTRO
}

enum ReferralSource {
  INDICACAO
  INSTAGRAM
  FACEBOOK
  GOOGLE
  SITE
  OUTRO
}

model Intake {
  id                  String          @id @default(cuid())
  clientId            String          @map("client_id")
  companyId           String?         @map("company_id")
  userId              String          @map("user_id")
  practiceAreas       PracticeArea[]  @map("practice_areas")
  practiceAreaOther   String?         @map("practice_area_other")
  clientReport        String?         @map("client_report")
  lawyerAnalysis      String?         @map("lawyer_analysis")
  nextSteps           NextStep[]      @map("next_steps")
  nextStepsOther      String?         @map("next_steps_other")
  feeAmount           Float?          @map("fee_amount")
  paymentMethod       String?         @map("payment_method")
  referralSource      ReferralSource? @map("referral_source")
  referredByName      String?         @map("referred_by_name")
  referralSourceOther String?         @map("referral_source_other")
  lgpdConsent         Boolean         @default(false) @map("lgpd_consent")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id])

  @@index([clientId, createdAt(sort: Desc)])
  @@map("intakes")
}

model Document {
  id           String   @id @default(cuid())
  clientId     String   @map("client_id")
  companyId    String?  @map("company_id")
  userId       String   @map("user_id")
  originalName String   @map("original_name")
  remotePath   String   @map("remote_path")
  mimeType     String   @map("mime_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id])

  @@index([clientId, companyId, createdAt(sort: Desc)])
  @@map("documents")
}

model Template {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  title       String
  content     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("templates")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  title       String
  description String?
  status      TaskStatus @default(TODO)
  position    Int
  dueDate     DateTime?  @map("due_date") @db.Date
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, position])
  @@map("tasks")
}

model Event {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  title                 String
  description           String?
  startAt               DateTime  @map("start_at")
  isGlobal              Boolean   @default(false) @map("is_global")
  reminderMinutesBefore Int?      @map("reminder_minutes_before")
  reminderSentAt        DateTime? @map("reminder_sent_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([isGlobal, startAt])
  @@map("events")
}

model Process {
  id         String   @id @default(cuid())
  caseNumber String?  @map("case_number")
  clientId   String   @map("client_id")
  userId     String   @map("user_id")
  plaintiff  String
  defendant  String
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  client    Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user      User              @relation(fields: [userId], references: [id])
  movements ProcessMovement[]

  @@index([clientId, createdAt(sort: Desc)])
  @@map("processes")
}

model ProcessMovement {
  id          String   @id @default(cuid())
  processId   String   @map("process_id")
  description String
  occurredAt  DateTime @map("occurred_at") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, occurredAt(sort: Desc)])
  @@map("process_movements")
}
