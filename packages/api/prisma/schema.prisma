generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  intakes Intake[]
  tasks   Task[]

  @@map("users")
}

model Client {
  id            String    @id @default(cuid())
  fullName      String    @map("full_name")
  cpf           String    @unique
  rg            String?
  birthDate     DateTime? @map("birth_date") @db.Date
  maritalStatus String?   @map("marital_status")
  profession    String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  intakes Intake[]

  @@index([fullName])
  @@map("clients")
}

enum PracticeArea {
  PREVIDENCIARIO
  TRABALHISTA
  CIVEL
  FAMILIA
  CONSUMIDOR
  EMPRESARIAL
  CONTRATOS
  OUTRO
}

enum NextStep {
  SOLICITAR_DOCUMENTOS
  ELABORAR_PARECER
  AGENDAR_RETORNO
  ELABORAR_CONTRATO
  PROTOCOLAR_ACAO
  TENTATIVA_ACORDO
  OUTRO
}

enum ReferralSource {
  INDICACAO
  INSTAGRAM
  FACEBOOK
  GOOGLE
  SITE
  OUTRO
}

model Intake {
  id                  String          @id @default(cuid())
  clientId            String          @map("client_id")
  userId              String          @map("user_id")
  practiceAreas       PracticeArea[]  @map("practice_areas")
  practiceAreaOther   String?         @map("practice_area_other")
  clientReport        String?         @map("client_report")
  lawyerAnalysis      String?         @map("lawyer_analysis")
  nextSteps           NextStep[]      @map("next_steps")
  nextStepsOther      String?         @map("next_steps_other")
  feeAmount           Float?          @map("fee_amount")
  paymentMethod       String?         @map("payment_method")
  referralSource      ReferralSource? @map("referral_source")
  referredByName      String?         @map("referred_by_name")
  referralSourceOther String?         @map("referral_source_other")
  lgpdConsent         Boolean         @default(false) @map("lgpd_consent")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId, createdAt(sort: Desc)])
  @@map("intakes")
}

model Template {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  title       String
  content     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("templates")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  title       String
  description String?
  status      TaskStatus @default(TODO)
  position    Int
  dueDate     DateTime?  @map("due_date") @db.Date
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, position])
  @@map("tasks")
}
